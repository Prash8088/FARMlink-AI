{
  "info": {
    "name": "FARMlink AI - v2 API Collection",
    "description": "Postman Collection for FARMlink AI (Version 1 Auth & Portals + Version 2 Farmer Marketplace Module)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Farmer (Ramesh)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer.ramesh@farmlink.ai\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@farmlink.ai\",\n  \"password\": \"Admin@FarmLink2026!\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current Session User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FARMER_TOKEN}}" }],
            "url": { "raw": "http://localhost:5000/api/auth/me", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Farmer Marketplace (V2)",
      "item": [
        {
          "name": "Get My Produce Listings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FARMER_TOKEN}}" }],
            "url": { "raw": "http://localhost:5000/api/products/my-products", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "products", "my-products"] }
          }
        },
        {
          "name": "Create Crop Listing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{FARMER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cropName\": \"Organic Basmati Rice 1121\",\n  \"category\": \"Grains & Cereals\",\n  \"description\": \"Extra-long grain aromatic aged basmati rice. Sun-dried and double polished.\",\n  \"quantity\": 150,\n  \"unit\": \"quintal\",\n  \"pricePerUnit\": 4200,\n  \"qualityGrade\": \"Grade A (Premium)\",\n  \"harvestDate\": \"2026-10-28\",\n  \"pickupLocation\": \"Gate 1, Golden Field Farm, Highway Rd\",\n  \"state\": \"Gujarat\",\n  \"district\": \"Mehsana\",\n  \"village\": \"Kadi\",\n  \"images\": [\"https://images.unsplash.com/photo-1586201375761-83865001e31c?auto=format&fit=crop&q=80&w=800\"]\n}"
            },
            "url": { "raw": "http://localhost:5000/api/products", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "products"] }
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/products/{{PRODUCT_ID}}", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "products", "{{PRODUCT_ID}}"] }
          }
        },
        {
          "name": "Update Product Details",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{FARMER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerUnit\": 4350,\n  \"description\": \"Updated harvest batch with moisture below 9%.\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/products/{{PRODUCT_ID}}", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "products", "{{PRODUCT_ID}}"] }
          }
        },
        {
          "name": "Update Available Stock",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{FARMER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 110\n}"
            },
            "url": { "raw": "http://localhost:5000/api/products/{{PRODUCT_ID}}/stock", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "products", "{{PRODUCT_ID}}", "stock"] }
          }
        },
        {
          "name": "Toggle Product Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{FARMER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"unavailable\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/products/{{PRODUCT_ID}}/status", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "products", "{{PRODUCT_ID}}", "status"] }
          }
        },
        {
          "name": "Delete Product Listing",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{FARMER_TOKEN}}" }],
            "url": { "raw": "http://localhost:5000/api/products/{{PRODUCT_ID}}", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "products", "{{PRODUCT_ID}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin Operations",
      "item": [
        {
          "name": "Get Admin Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "http://localhost:5000/api/admin/dashboard", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "admin", "dashboard"] }
          }
        },
        {
          "name": "Get All Marketplace Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "http://localhost:5000/api/admin/products", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "admin", "products"] }
          }
        },
        {
          "name": "Deactivate Product Listing (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"deactivated_by_admin\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/admin/products/{{PRODUCT_ID}}/status", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "admin", "products", "{{PRODUCT_ID}}", "status"] }
          }
        }
      ]
    }
  ]
}
