{
  "info": {
    "_postman_id": "farmlink-ai-v3-collection",
    "name": "FARMlink AI - Version 3 API Collection",
    "description": "Production API Collection for FARMlink AI Version 3: Buyer Marketplace, Price Negotiation & Order Management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "buyerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "farmerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "offerId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login Buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer.ananya@farmlink.ai\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Farmer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer.ramesh@farmlink.ai\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@farmlink.ai\",\n  \"password\": \"Admin@FarmLink2026!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Buyer Marketplace",
      "item": [
        {
          "name": "Get Active Marketplace Listings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/marketplace/products?category=Grains & Cereals&sortBy=price_asc&page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["marketplace", "products"],
              "query": [
                { "key": "category", "value": "Grains & Cereals" },
                { "key": "sortBy", "value": "price_asc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" }
              ]
            }
          }
        },
        {
          "name": "Get Single Produce Listing Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/marketplace/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["marketplace", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Get Filter Dropdowns Metadata",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }],
            "url": { "raw": "{{baseUrl}}/marketplace/filters", "host": ["{{baseUrl}}"], "path": ["marketplace", "filters"] }
          }
        }
      ]
    },
    {
      "name": "3. Orders & Price Negotiation",
      "item": [
        {
          "name": "Create Purchase Request (Buyer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"requestedQuantity\": 25,\n  \"initialOfferPrice\": 3100,\n  \"buyerMessage\": \"Prompt delivery required next week.\",\n  \"deliveryLocation\": {\n    \"address\": \"Plot 14, APMC Wholesale Yard\",\n    \"district\": \"Bhopal\",\n    \"state\": \"Madhya Pradesh\",\n    \"pincode\": \"462001\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "Get Buyer Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/buyer", "host": ["{{baseUrl}}"], "path": ["orders", "buyer"] }
          }
        },
        {
          "name": "Get Farmer Incoming Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{farmerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/farmer", "host": ["{{baseUrl}}"], "path": ["orders", "farmer"] }
          }
        },
        {
          "name": "Get Order By ID (Negotiation Thread)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}"] }
          }
        },
        {
          "name": "Submit Counter-Offer (Farmer / Buyer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{farmerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offeredPrice\": 3150,\n  \"offeredQuantity\": 25,\n  \"message\": \"Can supply 25 quintals at Rs 3150 for this Grade A lot.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/offers", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "offers"] }
          }
        },
        {
          "name": "Accept or Reject Offer",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accept\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/offers/{{offerId}}/respond",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "offers", "{{offerId}}", "respond"]
            }
          }
        },
        {
          "name": "Confirm Order (Buyer - Atomic Stock Reservation)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/confirm", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "confirm"] }
          }
        },
        {
          "name": "Cancel Order (Atomic Stock Restoration)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Procurement rescheduled.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/cancel", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "cancel"] }
          }
        },
        {
          "name": "Complete Order",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{farmerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/complete", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "complete"] }
          }
        }
      ]
    },
    {
      "name": "4. Admin Governance",
      "item": [
        {
          "name": "Get All Platform Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/orders", "host": ["{{baseUrl}}"], "path": ["admin", "orders"] }
          }
        }
      ]
    }
  ]
}
